node_modules/
coverage/

# Gitignored local-only staging — absent on fresh clones; never in the shared graph
.ai-upstream/
.copilot/

# Version control + environment
.git/
.venv/
__pycache__/
*.pyc

# Noise files
*.log
*.tmp
*.lock
package-lock.json

