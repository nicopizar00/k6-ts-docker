dist/
reports/
# Graphify shared-artifact policy:
# - only root graphify-out/graph.json and graphify-out/GRAPH_REPORT.md may be tracked
# - nested or renamed graphify output folders stay local-only
graphify-out/*
**/graphify-out/*
graphify-out-*/*
**/graphify-out-*/*
graphify-out_*/*
**/graphify-out_*/*
# Allowlist: committed shared artifacts only (validated, no local paths — ADR 0002)
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
# `punch init` first-wave bootstrap output — disposable; regenerate any time.
docs/ai/governance/init/
node_modules/
__pycache__/
*.pyc
.python-version
.copilot/

# .ai-upstream/ is a LOCAL staging area: safe-copy upstream skills here, then
# promote/adapt into .github/ (canon). Not version-controlled. See .ai-upstream/.gitkeep
.ai-upstream/*
!.ai-upstream/.gitkeep

# .github/.ai-upstream/ tracks only the required-vendor-skill manifest; the
# manually-installed vendor skill folders stay untracked (kept verbatim).
.github/.ai-upstream/*
!.github/.ai-upstream/README.md
